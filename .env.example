# Скопируйте в .env и заполните. Пустые обязательные поля не дадут запуститься.

# prod | dev
ENVIRONMENT=prod

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=statcab
POSTGRES_USER=statcab
POSTGRES_PASSWORD=
# сгенерировать: openssl rand -hex 32   (или в PowerShell: -join ((65..90)+(97..122)+(48..57)|Get-Random -Count 48|%{[char]$_}))
SECRET_KEY=

# Пул соединений PostgreSQL: свой у каждого воркера uvicorn. Потолок считается так:
#   UVICORN_WORKERS × (DB_POOL_SIZE + DB_MAX_OVERFLOW) < max_connections PostgreSQL
# (в PostgreSQL по умолчанию 100). SQLite эти переменные игнорирует.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# отпускать соединение раз в N секунд: pooler или файрвол рвёт простые коннекты
# молча, recycle дешевле, чем заметить оборванный коннект на первом же запросе
DB_POOL_RECYCLE_SEC=1800

# --- Доступ -----------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=1
ADMIN_LOGIN=admin
# если пусто — при первом запуске создадим случайный и покажем в логе (смените!)
ADMIN_PASSWORD=

# адрес фронта для CORS (через запятую). Фронт и API на одном nginx-origine не нужны,
# но оставь сюда http://<сервер>:<порт>, если фронт живёт отдельно
CORS_ORIGINS=http://localhost:8080

# Флаг Secure у refresh-cookie: пусто = авто (включён при ENVIRONMENT=prod).
# Сервер доступен по http:// без сертификата (корпоративный интранет) — поставь false,
# иначе сессия протухнет через ACCESS_TOKEN_TTL_MINUTES. Есть HTTPS — не трогай.
COOKIE_SECURE=

# Доверять X-Forwarded-For. В docker-compose включено (перед backend стоит наш nginx),
# поэтому аудит и лимит подбора пароля видят IP клиента. Кабинет наружу смотрит прямо
# uvicorn'ом без прослойки — оставь false: иначе любой подставит себе IP в заголовке.
# TRUST_PROXY_HOPS — сколько адресов дописывает твой прокси (nginx = 1; nginx поверх
# облачного балансировщика = 2).
TRUST_PROXY_HEADERS=true
TRUST_PROXY_HOPS=1

# --- 1С ---------------------------------------------------------------------
# mock = демо-данные, http = HTTP-сервис 1С (см. docs/03_контракт_1с.md)
ONE_C_SOURCE=mock
ONE_C_BASE_URL=
ONE_C_LOGIN=
ONE_C_PASSWORD=
ONE_C_TIMEOUT_SEC=30
# Таймаут кнопки «проверить связь»: четыре GET, каждый не дольше этого времени,
# установка соединения — 3 с. Иначе проверка недоступной 1С занимает поток
# кабинета на 4 × ONE_C_TIMEOUT_SEC (было до 120 с).
ONE_C_PROBE_TIMEOUT_SEC=8

# Push-режим: 1С сама присылает срез на POST /api/onec/push (заголовок X-OneC-Token).
# Пусто — эндпоинт закрыт (503). Сгенерировать: openssl rand -hex 32
ONEC_PUSH_TOKEN=

SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=15

# «Отчёт диспетчера» .xlsm, если загружаем файлом, а не из 1С (можно и из админки).
# Путь внутри контейнера backend, том statcab_data смонтирован в /app/data.
DISPATCHER_XLSM_PATH=
DISPATCHER_AUTO_IMPORT=true

# наполнить витрину демо-данными (в проде false)
SEED_DEMO_DATA=false

WEB_PORT=8080
# адрес, которым кабинет торчит наружу. По умолчанию только loopback: до
# publish-порта docker не слушает hosts-ограничения compose, поэтому значение
# 0.0.0.0 открывает HTTP-кабинет без TLS на весь интерфейс (п. 21 TASKS2.md).
# Ставь 0.0.0.0, только когда снаружи стоит твой nginx (WEB_BIND=0.0.0.0 вместе
# с docker-compose.host-nginx.yml) либо кабинет сознательно работает без TLS.
WEB_BIND=127.0.0.1
# воркеров uvicorn. НЕ «2 × vCPU + 1»: планировщик и блокировка синхронизации
# живут внутри процесса, N воркеров — это N синхронизаций с 1С за интервал и
# N×пул соединений к PostgreSQL. Кабинет — внутренний сервис на ~12 человек:
# 1 воркер; 2 — если профиль запросов изменится. Формула:
# min(2 × vCPU + 1, max_connections PostgreSQL / (DB_POOL_SIZE + DB_MAX_OVERFLOW)).
UVICORN_WORKERS=1
# READY_TOKEN — токен пробы готовности /readyz (он же /api/readyz): healthcheck
# внутри контейнера читает его отсюда и передаёт в /readyz. /readyz принимает
# значение отсюда ИЛИ из стора настроек (ключ service.readyz_token в админке) —
# заводить токен в двух местах не нужно. Healthcheck контейнера токена не требует
# вовсе: 403 для него — «приложение живо», контейнер не краснеет.
# Пусто здесь и в сторе — токен не заводили: /readyz открыт, но это видно в теле
# ответа (token_required: false). Порог возраста витрины здесь не настраивается:
# он в сторе, ключ sync.age_limit_sec (по умолчанию 5400 с).
READY_TOKEN=

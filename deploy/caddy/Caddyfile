# Домен → кабинет. Сертификат Caddy выпустит у Let's Encrypt сам
# (нужны A-запись на этот сервер и порты 80/443 из интернета).
cab.example.ru {
	reverse_proxy web:80
}

# Внутренний домен без публичного доступа (сертификат не выпустить):
# служебный CA или http — см. docs/06, раздел «Домен и nginx».
